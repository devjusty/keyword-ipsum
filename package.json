{
  "name": "keyword-ipsum",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.3",
  "description": "A simple keyword-based lorem ipsum generator",
  "homepage": "https://keywordipsum.justy.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/devjusty/keyword-ipsum"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Thompson",
    "email": "devjusty@gmail.com"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "knip": "knip",
    "preview": "vite preview",
    "test": "vitest",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "dompurify": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-ga4": "^3.0.1",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@netlify/vite-plugin": "^3.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
